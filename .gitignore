# macOS
.DS_Store

# Parola reală: se păstrează doar local și pe server (vezi admin/config.example.php)
mocha_v2/admin/config.php

# Copiile automate de siguranță ale meniului (se generează pe server)
mocha_v2/data/backups/*.json
!mocha_v2/data/backups/.htaccess

# Fișiere temporare de la salvare
*.tmp-*

# Jurnale de erori PHP de pe server
error_log
.claude/

# Baza de date cu comenzi (doar pe server)
mocha_v2/data/db/*.sqlite*

# Sesiunile de autentificare (doar pe server)
mocha_v2/data/sessions/*/

# Arhive de urcare pe server (pot conține config.php cu parola)
*.zip

# Pozele facturilor scanate (doar pe server); .htaccess-ul folderului rămâne în repo
mocha_v2/data/invoices/*
!mocha_v2/data/invoices/.htaccess
