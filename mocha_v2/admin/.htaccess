Options -Indexes
<Files "config.php">
  Require all denied
</Files>
# Paginile de administrare nu pot fi încadrate în alte site-uri și nu apar în motoarele de căutare
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
